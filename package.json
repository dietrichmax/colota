{
  "name": "colota",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "render:store-screenshots": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/render-store-screenshots.mjs",
    "generate:icons": "node packages/shared/logo/generate-icons.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
